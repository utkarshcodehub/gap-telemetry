# --- Auth: configure exactly one of these two ---

# Production: your Supabase project URL. Tokens are verified locally
# against https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
# (no secret needs to be stored here at all).
SUPABASE_URL=https://<your-ref>.supabase.co

# Local dev only, before you've created a Supabase project: any random
# string. Mint a matching test token with scripts/mint_dev_token.py.
AUTH_LOCAL_HS256_SECRET=any-random-string-for-local-dev

# --- Data layer: Supabase Postgres (see core/db/store.py) ---
# anon key: public, not secret — used with each signed-in user's own bearer
# token so Postgres Row-Level Security enforces per-user isolation for real.
# Project Settings -> API -> Project API keys -> anon / public.
SUPABASE_ANON_KEY=your-anon-key

# service_role key: SECRET, bypasses Row-Level Security. Only needed for the
# admin write path (scraper/synthetic_generator ingest into postings/skills).
# Get it from: Supabase dashboard -> Project Settings -> API -> service_role
# secret key. Without it the app still runs fine (read-only market data).
# SUPABASE_SERVICE_ROLE_KEY=

# --- CORS: comma-separated allowed frontend origins ---
CORS_ORIGINS=http://localhost:5173

# --- Uploads ---
MAX_UPLOAD_MB=5

# --- Rate limits (see slowapi/limits syntax) ---
RATE_LIMIT_ANALYZE=10/minute
RATE_LIMIT_ROADMAP=10/minute
RATE_LIMIT_DEFAULT=60/minute

# --- LLM (optional — falls back to the template roadmap engine without it) ---
# GROQ_API_KEY=your_groq_key

# --- GitHub (optional — raises the unauthenticated 60 req/hr rate limit) ---
# GITHUB_TOKEN=your_github_pat

# --- Market data feed (optional — only the offline ingest scripts use it) ---
# Free tier is 200 requests/month. Subscribe DIRECTLY at openwebninja.com and
# enable the JSearch API on the account; do not go via RapidAPI.
# OPENWEBNINJA_API_KEY=your_openwebninja_key

# --- Test safety (required to run the suite) ---
# The test fixtures DELETE every row in `postings` and `skills` for deterministic
# counts. They refuse to run unless the project ref parsed from SUPABASE_URL is
# named here, so repointing .env at a project that matters blocks the suite
# instead of silently wiping it. Set it to your own disposable project's ref:
#   https://<THIS-PART>.supabase.co
# DESTRUCTIVE_TESTS_ALLOW_REF=your_project_ref

# --- Evidence engine ---
# CONTRADICTED is computed but hidden until Dataset A validates the rule; a claim
# that would be contradicted reports UNVERIFIABLE instead. Turn on deliberately.
# REVEAL_CONTRADICTED_VERDICT=false
